{
  "name": "serenade",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "build:static": "cross-env REACT_ROUTER_SSR=false react-router build",
    "new:post": "node --env-file-if-exists=.env scripts/new-post.js",
    "new:column": "node --env-file-if-exists=.env scripts/new-column.js",
    "sync": "node --env-file-if-exists=.env scripts/sync.js"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@fontsource-variable/noto-serif-sc": "^5.2.5",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "@tailwindcss/typography": "^0.5.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.13",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "isbot": "^5",
    "katex": "^0.16.22",
    "lucide-react": "^1.37.0",
    "marked": "^17.0.0",
    "marked-katex-extension": "^5.1.7",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "rss": "^1.2.2",
    "rss-parser": "^3.13.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
