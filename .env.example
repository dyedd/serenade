# AI API Configuration
# 复制此文件为 .env 并填入你的 API 密钥（不要提交 .env）

# OpenAI-compatible API for slug generation
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Image generation API for optional post covers
IMAGE_API_KEY=your_image_api_key_here
IMAGE_API_MODE=images
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2

# Server Configuration (用于同步文件到服务器)
SERVER_HOST=your_server_ip_or_domain
SERVER_USER=deploy
SERVER_PATH=/srv/serenade

# Site Configuration
SITE_AUTHOR=Sample Writer
SITE_TITLE=Sample Notes
SITE_DESCRIPTION=Notes on software, systems, and small experiments
SITE_KEYWORDS=software,systems,notes,programming
SITE_URL=https://example.com
SITE_EMAIL=hello@example.com
SITE_LANG=zh-CN
SITE_START_TIME=2025-01-01
SITE_ANALYTICS_SCRIPT=
SITE_ANALYTICS_WEBSITE_ID=
SITE_PROFILE_AVATAR=/avatar.jpg
SITE_PROFILE_INTRO=Building small tools and learning in public|Notes on code, systems, and everyday experiments
SITE_PROFILE_MOTTO=Keep it simple|Ship, learn, repeat
SITE_PROFILE_TECH_STACK=TypeScript::https://cdn.simpleicons.org/typescript/3178C6|React::https://cdn.simpleicons.org/react/61DAFB|SQLite::https://cdn.simpleicons.org/sqlite/003B57|Docker::https://cdn.simpleicons.org/docker/2496ED
SITE_PROFILE_GITHUB_CHART=https://ghchart.rshah.org/409ba5/example-user
SITE_GITHUB_URL=https://github.com/example-user
SITE_QQ_URL=https://example.com/contact
SITE_FOOTER_ICP_LABEL=Example site
